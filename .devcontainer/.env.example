# Copy this file to .devcontainer/.env and replace each path with a repository checkout on your host.
DEV_REPO_API=/absolute/path/to/api
DEV_REPO_UI=/absolute/path/to/ui
DEV_REPO_UI_PUBLIC=/absolute/path/to/ui-public

# Public SSH keys used for commit signing and GitHub authentication.
# These may point to the same file.
# VS Code forwards the matching private keys; do not mount private keys!
DEV_GIT_SIGNING_PUBLIC_KEY=/absolute/path/to/your-signing-key.pub
DEV_GITHUB_AUTH_PUBLIC_KEY=/absolute/path/to/your-github-auth-key.pub
